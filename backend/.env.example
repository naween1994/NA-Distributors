# Copy values into your shell or deployment environment. The app does not load this file automatically.
PORT=3001
# Optional; defaults to backend/data/na-distributors.sqlite when started with npm workspaces.
# DATABASE_PATH=/absolute/path/to/na-distributors.sqlite
# Production HTTPS deployments should set this to true.
COOKIE_SECURE=false
# Only needed for a separately hosted frontend. Comma-separated trusted origins, no trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Additional HTTPS origins permitted by the production web app's Content-Security-Policy.
# CSP_CONNECT_ORIGINS=https://api.example.com
# Optional for first-time public deployments: a random setup code required before creating the admin password.
# SETUP_TOKEN=<generate securely; do not commit or send in chat>
# Set only when the API is reachable exclusively through one controlled reverse proxy.
TRUST_PROXY_HOPS=0
# Deployments can restrict the API listener to loopback when using host networking and a local proxy.
HOST=0.0.0.0
